{
  "name": "last-oasis-control-center",
  "version": "0.1.17",
  "private": true,
  "author": "Ace",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:server": "node node_modules/typescript/bin/tsc -p tsconfig.server.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.app.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.server.build.json && node node_modules/vite/bin/vite.js build",
    "build:dedicated": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-dedicated-package.ps1",
    "start": "node dist/server/index.js",
    "start:dev": "tsx src/server/index.ts",
    "bootstrap:install": "tsx src/server/bootstrapInstall.ts",
    "up": "cmd /c lo-tool.cmd"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "json5": "^2.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
