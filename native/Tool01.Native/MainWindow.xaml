<Window x:Class="Tool01.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Last Oasis Dedicated Server Tool"
        Height="940"
        Width="1580"
        MinHeight="780"
        MinWidth="1280"
        Background="#180E09"
        Foreground="#F3E5D3"
        Icon="/Assets/LastOasisManager.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1D130E" />
        <SolidColorBrush x:Key="PanelBrushAlt" Color="#2B1B13" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E7A04D" />
        <SolidColorBrush x:Key="AccentMutedBrush" Color="#9A4B20" />
        <SolidColorBrush x:Key="TextBrush" Color="#F7E7CF" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#D1B996" />
        <SolidColorBrush x:Key="BorderBrushWarm" Color="#704824" />
        <SolidColorBrush x:Key="DataGridBrush" Color="#17100C" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#24110A" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F0B562" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#F8D694" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#C87028" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#120B07" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <EventSetter Event="PreviewMouseWheel" Handler="NestedScrollable_PreviewMouseWheel" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#120B07" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="DropDownButton"
                                                  Grid.ColumnSpan="2"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter Margin="10,4,6,4"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Border Grid.Column="1"
                                            Background="#4A2C1B"
                                            BorderBrush="{StaticResource BorderBrushWarm}"
                                            BorderThickness="1,0,0,0"
                                            CornerRadius="0,6,6,0"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="v"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   FontSize="14" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   PopupAnimation="Fade">
                                <Border Background="#120B07"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"
                                                  CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#120B07" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B2416" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#2A180E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource DataGridBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <EventSetter Event="PreviewMouseWheel" Handler="NestedScrollable_PreviewMouseWheel" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrushAlt}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrushWarm}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="10,10,0,0"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#2A180E" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#3A2416" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource DataGridBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowBackground" Value="#1A100A" />
            <Setter Property="AlternatingRowBackground" Value="#22140D" />
            <Setter Property="HorizontalGridLinesBrush" Value="#4C311C" />
            <Setter Property="VerticalGridLinesBrush" Value="#4C311C" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <EventSetter Event="PreviewMouseWheel" Handler="NestedScrollable_PreviewMouseWheel" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D1A11" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="#1A100A" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2B190F" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushWarm}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="ThemedScrollBarButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Background="#A9642C"
                                BorderBrush="#E7A04D"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#D9893D" />
                                <Setter TargetName="ThumbChrome" Property="BorderBrush" Value="#F0B562" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#F0B562" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="NestedScrollable_PreviewMouseWheel" />
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="#120B07"
                    BorderBrush="{StaticResource BorderBrushWarm}"
                    BorderThickness="1,0,0,0">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="True"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ThemedScrollBarButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="34" Style="{StaticResource ThemedScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ThemedScrollBarButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="#120B07"
                    BorderBrush="{StaticResource BorderBrushWarm}"
                    BorderThickness="0,1,0,0">
                <Track x:Name="PART_Track"
                       IsDirectionReversed="False"
                       Focusable="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ThemedScrollBarButtonStyle}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="34" Style="{StaticResource ThemedScrollThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ThemedScrollBarButtonStyle}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#140C08" />
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="14" />
                    <Setter Property="MinHeight" Value="14" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="16,16,16,12"
                Padding="0"
                CornerRadius="18"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushWarm}"
                BorderThickness="1">
            <Grid ClipToBounds="True">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#331A0F" Offset="0" />
                            <GradientStop Color="#1A0E09" Offset="0.48" />
                            <GradientStop Color="#4A2414" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Path Data="M 0 92 C 200 40 350 140 565 72 C 760 12 910 32 1220 18 L 1220 140 L 0 140 Z"
                      Fill="#2C0F0805"
                      Opacity="0.55"
                      Stretch="Fill" />
                <Path Data="M 850 0 L 1040 0 L 1135 122 L 980 118 Z"
                      Fill="#4AD28A3C"
                      Opacity="0.32"
                      Stretch="Fill" />
                <Path Data="M 120 18 L 378 62 L 132 88 Z"
                      Fill="#55E6A04A"
                      Opacity="0.30"
                      Stretch="Fill" />
                <Border Background="#9C120A06" />
                <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Last Oasis Server Manager" Foreground="{StaticResource AccentBrush}" FontSize="34" FontWeight="Black" FontFamily="Bahnschrift SemiBold" Margin="0,8,0,4" />
                    <TextBlock Text="Dedicated server controls for realm hosts, restarts, mods, MyRealm, and event tile cycles."
                               Foreground="{StaticResource AccentBrush}" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock Text="Made by Ace - MIT License"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BackendStateText" Text="Backend: checking..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="HeaderSelectedText" Text="Selected host: -" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    <TextBlock x:Name="HeaderLaunchText" Text="Launch phase: -" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Realm Hosts" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="Profile selection and launch controls live here now, not in a browser."
                                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ListBox x:Name="ProfilesListBox"
                                 DisplayMemberPath="Name"
                                 Height="190"
                                 SelectionChanged="ProfilesListBox_SelectionChanged"
                                 Margin="0,0,0,12" />
                        <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Profiles" Style="{StaticResource SectionLabelStyle}" />
                                <WrapPanel>
                                    <Button Content="Create Host"
                                            Click="CreateProfileButton_Click"
                                            ToolTip="Create a new realm host profile with fresh ports and identifier." />
                                    <Button x:Name="DeleteProfileButton"
                                            Content="Delete Host"
                                            Click="DeleteProfileButton_Click"
                                            ToolTip="Delete the selected host profile." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Manager" Style="{StaticResource SectionLabelStyle}" />
                                <WrapPanel>
                                    <Button Content="Refresh Status" Click="RefreshButton_Click" />
                                    <Button Content="Connect Backend" Click="StartBackendButton_Click" ToolTip="Start or reconnect the local manager backend." />
                                    <Button Content="Disconnect Backend" Click="StopBackendButton_Click" ToolTip="Stop only the local manager backend, not the game server." />
                                    <Button Content="Enable Backend Startup" Click="EnableBackendAutostartButton_Click" ToolTip="Install/start the watchdog task so the manager backend starts at Windows login and restarts if it crashes." />
                                    <Button Content="Disable Backend Startup" Click="DisableBackendAutostartButton_Click" ToolTip="Remove the watchdog startup task. This does not stop the backend." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Server Actions" Style="{StaticResource SectionLabelStyle}" />
                                <WrapPanel>
                                    <Button Content="Start Selected Host" Click="StartSelectedButton_Click" />
                                    <Button Content="Start All Hosts" Click="StartAllButton_Click" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="SafeStopButton"
                                            Content="Schedule Safe Stop"
                                            Click="SafeStopButton_Click"
                                            ToolTip="Warn in Discord, wait 10 minutes, then stop the active realm host pool for maintenance." />
                                    <Button x:Name="StopAllButton"
                                            Content="Stop All Now"
                                            Click="StopAllButton_Click"
                                            ToolTip="Stop all running hosts immediately." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrushAlt}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Snapshot" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBlock x:Name="SidebarSelectedHostText" Text="Selected host: -" />
                                <TextBlock x:Name="SidebarLaunchPhaseText" Text="Launch phase: -" />
                                <TextBlock x:Name="SidebarRunningHostsText" Text="Running hosts: -" />
                                <TextBlock x:Name="SidebarDesiredHostsText" Text="Desired hosts: -" />
                                <TextBlock x:Name="SidebarEventPhaseText" Text="Event phase: -" />
                                <TextBlock x:Name="SidebarMyRealmText" Text="MyRealm: -" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <TabControl x:Name="MainTabControl" Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DashboardTabRoot" Margin="18">
                            <WrapPanel Margin="0,0,0,10">
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="250">
                                        <TextBlock Text="Selected Host" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="DashboardSelectedHostText" Text="-" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="250">
                                        <TextBlock Text="Public Address" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="DashboardPublicIpText" Text="-" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="250">
                                        <TextBlock Text="Local Address" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="DashboardLocalIpText" Text="-" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="320">
                                        <TextBlock Text="Launch Summary" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="DashboardLaunchSummaryText" Text="-" TextWrapping="Wrap" FontSize="16" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <GroupBox Header="Control Center Status">
                                <TextBox x:Name="StatusLogTextBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         Height="120"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" />
                            </GroupBox>

                            <GroupBox Header="Audit">
                                <TextBox x:Name="AuditStatusTextBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         Height="150"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" />
                            </GroupBox>

                            <GroupBox Header="Live Servers">
                                <DataGrid x:Name="LiveServersGrid"
                                          Height="430"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Host" Binding="{Binding Identifier}" Width="160" />
                                        <DataGridTextColumn Header="Map" Binding="{Binding Map}" Width="180" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                        <DataGridTextColumn Header="Players" Binding="{Binding PlayerCount}" Width="80" />
                                        <DataGridTextColumn Header="Game Port" Binding="{Binding GamePort}" Width="90" />
                                        <DataGridTextColumn Header="Query Port" Binding="{Binding QueryPort}" Width="90" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Header="Installed Workshop Mods">
                                <DataGrid x:Name="InstalledModsGrid"
                                          Height="260"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mod" Binding="{Binding DisplayTitle}" Width="320" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding InstallStatusLabel}" Width="140" />
                                        <DataGridTextColumn Header="Update" Binding="{Binding UpdateStatusLabel}" Width="140" />
