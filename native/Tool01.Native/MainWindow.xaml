                                            <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
                                            <DataGridCheckBoxColumn Header="Auto" Binding="{Binding AutoAdvance}" Width="70" />
                                            <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="90" />
                                            <DataGridTextColumn Header="Preview" Binding="{Binding PreviewTileCount}" Width="80" />
                                            <DataGridTextColumn Header="Active" Binding="{Binding ActiveTileCount}" Width="80" />
                                            <DataGridTextColumn Header="Next transition" Binding="{Binding NextTransitionAt}" Width="170" />
                                            <DataGridTextColumn Header="Last action" Binding="{Binding LastAction}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                            <WrapPanel>
                                <Button Content="Save Event Settings" Click="SaveEventButton_Click" />
                                <Button Content="Dry Run Next Batch" Click="DryRunEventBatchButton_Click" />
