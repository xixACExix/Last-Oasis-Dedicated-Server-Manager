                </TabItem>
                <TabItem Header="Host Profile">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProfileTabRoot" Margin="18">
                            <TextBlock Text="Edit the selected host here. Identifier, game port, query port, and override address must stay unique for each realm host."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <GroupBox Header="Selected Launch Profile">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="Profile name" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" x:Name="ProfileNameTextBox" TextChanged="ProfileEditorChanged" ToolTip="Friendly label shown in the host list and launch controls." />
                                    <TextBlock Grid.Column="2" Text="Identifier" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="3" x:Name="IdentifierTextBox" TextChanged="ProfileEditorChanged" ToolTip="Unique host identifier used by MyRealm, for example realm_server_1." />

                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Game port" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" Grid.Row="1" x:Name="GamePortTextBox" TextChanged="ProfileEditorChanged" ToolTip="Main join port for this host, for example 5555." />
                                    <TextBlock Grid.Column="2" Grid.Row="1" Text="Query port" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="3" Grid.Row="1" x:Name="QueryPortTextBox" TextChanged="ProfileEditorChanged" ToolTip="Server query/info port, for example 27015." />

                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Slots" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" Grid.Row="2" x:Name="SlotsTextBox" TextChanged="ProfileEditorChanged" ToolTip="Player capacity advertised for this host." />
                                    <TextBlock Grid.Column="2" Grid.Row="2" Text="Override address" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="3" Grid.Row="2" x:Name="OverrideAddressTextBox" TextChanged="ProfileEditorChanged" ToolTip="LAN or public IP that players should connect to." />

                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Extra args" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="3" x:Name="ExtraArgsTextBox" TextChanged="ProfileEditorChanged" ToolTip="Extra launch flags such as -noeac." />

                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                                        <CheckBox x:Name="EnableLogsCheckBox" Content="Logs enabled" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                        <CheckBox x:Name="ForceSteamLinkCheckBox" Content="Force Steam client link" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                        <CheckBox x:Name="MessagingCheckBox" Content="Messaging" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                        <CheckBox x:Name="EnableCheatsCheckBox" Content="Enable cheats" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                        <CheckBox x:Name="NoLiveServerCheckBox" Content="No live server" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                    </StackPanel>

                                    <Button Grid.Column="0"
                                            Grid.ColumnSpan="4"
                                            Grid.Row="6"
                                            Content="Save Profile"
                                            Click="SaveProfileButton_Click"
                                            Width="160"
                                            HorizontalAlignment="Left" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Restarts">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="Choose the first restart time and how many evenly spaced restarts should happen each day for the selected host."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <GroupBox Header="Restart Schedule">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="Restart enabled" Style="{StaticResource SectionLabelStyle}" />
                                    <CheckBox Grid.Column="1" x:Name="RestartEnabledCheckBox" Content="Automatic restart policy" Checked="ProfileEditorChanged" Unchecked="ProfileEditorChanged" />
                                    <TextBlock Grid.Column="2" Text="First restart time" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="3"
                                             x:Name="RestartStartTimeTextBox"
                                             TextChanged="ProfileEditorChanged"
                                             ToolTip="Clock time for the first restart of the day. Example: 00:00 for midnight." />
                                    
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Restarts per day" Style="{StaticResource SectionLabelStyle}" />
                                    <ComboBox Grid.Column="1"
                                              Grid.Row="1"
                                              x:Name="RestartTimesPerDayComboBox"
                                              SelectionChanged="ProfileEditorChanged"
                                              ToolTip="How many evenly spaced restart times to create from the first restart time.">
                                        <ComboBoxItem Content="1 time a day" Tag="1" />
                                        <ComboBoxItem Content="2 times a day" Tag="2" />
                                        <ComboBoxItem Content="3 times a day" Tag="3" />
                                        <ComboBoxItem Content="4 times a day" Tag="4" />
                                        <ComboBoxItem Content="5 times a day" Tag="5" />
                                        <ComboBoxItem Content="6 times a day" Tag="6" />
                                        <ComboBoxItem Content="8 times a day" Tag="8" />
                                        <ComboBoxItem Content="12 times a day" Tag="12" />
                                    </ComboBox>

                                    <TextBlock Grid.Column="2"
                                               Grid.ColumnSpan="2"
                                               Grid.Row="1"
                                               x:Name="RestartSchedulePreviewText"
                                               Text="Restart times will show here after loading or saving."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Warning minutes" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1"
                                             Grid.Row="2"
                                             x:Name="RestartWarningMinutesTextBox"
                                             TextChanged="ProfileEditorChanged"
                                             ToolTip="Scheduled restarts send in-game warnings at 30, 15, 10, and 5 minutes. Discord posts only the first warning for the restart plan; the 5 minute in-game command starts the widget." />
                                    <TextBlock Grid.Column="2" Grid.Row="2" Text="Current schedule" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock Grid.Column="3"
                                               Grid.Row="2"
                                               Text="Saved per selected host; Overview shows the next restart and skip state."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <WrapPanel Grid.Column="0"
                                               Grid.ColumnSpan="4"
                                               Grid.Row="3"
                                               Margin="0,8,0,0">
                                        <Button Content="Save Restart Policy"
                                                Click="SaveProfileButton_Click"
                                                ToolTip="Restart policy is saved with the selected host profile." />
                                        <Button Content="Skip Next Restart"
                                                Click="SkipNextRestartButton_Click"
                                                ToolTip="Skip the next scheduled restart for the selected host profile." />
                                        <Button Content="Clear Restart Skip"
                                                Click="ClearRestartSkipButton_Click"
                                                ToolTip="Clear the selected host profile restart skip." />
                                    </WrapPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Realm Keys">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RealmTabRoot" Margin="18">
                            <TextBlock Text="These values come from your MyRealm customer/provider pages. They identify your hosts to Last Oasis."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <GroupBox Header="Realm Keys">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Customer key" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" x:Name="CustomerKeyTextBox" TextChanged="RealmEditorChanged" ToolTip="MyRealm customer key from the customer page." />

                                    <TextBlock Grid.Row="1" Text="Provider key" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ProviderKeyTextBox" TextChanged="RealmEditorChanged" ToolTip="MyRealm provider key for this host." />

                                    <TextBlock Grid.Row="2" Text="Provider label" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="ProviderNameTextBox" TextChanged="RealmEditorChanged" ToolTip="Friendly provider label shown in MyRealm, for example DedicatedHost01." />

                                    <TextBlock Grid.Row="3" Text="API key" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="ApiKeyTextBox" TextChanged="RealmEditorChanged" ToolTip="MyRealm API key when official API access is available." />

                                    <Button Grid.Row="4"
                                            Grid.Column="1"
                                            Content="Save Realm Settings"
                                            Width="190"
                                            HorizontalAlignment="Left"
                                            Click="SaveRealmButton_Click" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Updates / Mods">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OperationsTabRoot" Margin="18">
                            <TextBlock Text="Network, shared updates, webhooks, and workshop controls are grouped here. Mod and dedicated server updates use one shared plan for the running tiles / host profiles."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="12" Margin="0,0,10,10">
                                    <StackPanel Width="230">
                                        <TextBlock Text="Setup" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock Text="Public IP, SteamCMD, branch, and webhook fields." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="12" Margin="0,0,10,10">
                                    <StackPanel Width="230">
                                        <TextBlock Text="Workshop" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock Text="Install, sync, reconcile, or apply pending shared mod updates for the configured tiles / host profiles." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="12" Margin="0,0,10,10">
                                    <StackPanel Width="230">
                                        <TextBlock Text="Restarts" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock Text="Shared update restarts cover the running tiles / host profiles; offline recovery stays separate." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="12" Margin="0,0,10,10">
                                    <StackPanel Width="230">
                                        <TextBlock Text="Storage" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock Text="Reusable profile folder, install context, and backups." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            <TabControl Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1">
                                <TabItem Header="Setup / Webhooks">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">
                            <GroupBox Header="Setup, Automation, and Webhooks">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                     <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="Last known public IP" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" x:Name="LastKnownPublicIpTextBox" TextChanged="OperationsEditorChanged" ToolTip="Stored public WAN IP used when switching hosts into public mode." />
                                    <WrapPanel Grid.Column="2" Grid.ColumnSpan="2">
                                        <Button Content="Detect Public IP" Click="DetectPublicIpButton_Click" ToolTip="Detect the current WAN IP and fill the field on the left." />
                                        <Button Content="Apply To Selected Profile" Click="ApplyPublicIpButton_Click" ToolTip="Copy the stored public IP into the selected host profile." />
                                        <Button Content="Use LAN Mode" Click="LanModeButton_Click" />
                                        <Button Content="Use Public Mode" Click="PublicModeButton_Click" />
                                    </WrapPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SteamCMD path" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SteamCmdPathTextBox" TextChanged="OperationsEditorChanged" ToolTip="Full path to steamcmd.exe used for updates and workshop downloads." />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="SteamCMD install folder" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="SteamCmdInstallDirectoryTextBox" TextChanged="OperationsEditorChanged" ToolTip="Folder that contains SteamCMD support files and login state." />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Workshop content path" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="WorkshopContentPathTextBox" TextChanged="OperationsEditorChanged" ToolTip="Steam workshop content folder for Last Oasis mods, usually ...\\workshop\\content\\903950." />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="App ID" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="AppIdTextBox" TextChanged="OperationsEditorChanged" ToolTip="Dedicated server Steam app ID, normally 920720." />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Branch override" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="BetaBranchTextBox" TextChanged="OperationsEditorChanged" ToolTip="Optional Steam branch override. Leave blank for the public branch." />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Mod IDs" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="3"
                                             x:Name="ModIdsTextBox"
                                             TextChanged="OperationsEditorChanged"
                                             Height="82"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="Wrap"
                                             ToolTip="One workshop mod ID per line, or separated by commas." />

                                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0">
                                        <WrapPanel>
                                             <CheckBox x:Name="DeleteMissingModsCheckBox" Content="Clear server mods folder before syncing" Checked="OperationsEditorChanged" Unchecked="OperationsEditorChanged" />
                                             <CheckBox x:Name="AutoUpdateModsCheckBox" Content="Automatically check shared workshop mod updates" Checked="OperationsEditorChanged" Unchecked="OperationsEditorChanged" />
                                             <CheckBox x:Name="AutoUpdateGameServerCheckBox" Content="Automatically check shared dedicated server updates" Checked="OperationsEditorChanged" Unchecked="OperationsEditorChanged" />
                                             <CheckBox x:Name="AutoRestartRealmsCheckBox" Content="Auto restart offline realm hosts" Checked="OperationsEditorChanged" Unchecked="OperationsEditorChanged" />
                                         </WrapPanel>
                                     </StackPanel>
 
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Mod check minutes" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="ModUpdateCheckMinutesTextBox" TextChanged="OperationsEditorChanged" />
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Mod restart delay" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="5"
                                             Grid.Column="3"
                                             x:Name="ModUpdateGraceMinutesTextBox"
                                             TextChanged="OperationsEditorChanged"
                                             IsReadOnly="True"
                                             ToolTip="Mod and dedicated server updates queue a restart 15 minutes later. Warnings are sent at 15, 10, and 5 minutes." />
 
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Server update minutes" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" x:Name="GameUpdateCheckMinutesTextBox" TextChanged="OperationsEditorChanged" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Offline restart grace" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="6" Grid.Column="3" x:Name="OfflineRestartGraceMinutesTextBox" TextChanged="OperationsEditorChanged" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="MyRealm activity webhook" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="7"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="3"
                                             x:Name="MyRealmWebhookTextBox"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Discord webhook used for MyRealm-backed tile online updates and player/status changes." />

                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Update webhook" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" x:Name="UpdateWebhookTextBox" TextChanged="OperationsEditorChanged" />

                                     <TextBlock Grid.Row="9" Grid.Column="0" Text="Event tile webhook" Style="{StaticResource SectionLabelStyle}" />
                                     <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3" x:Name="EventTileWebhookTextBox" TextChanged="OperationsEditorChanged" ToolTip="Discord webhook used when a new event tile batch is created. Includes map, quality, activation, and deactivation." />

                                     <TextBlock Grid.Row="10" Grid.Column="0" Text="Game chat webhook" Style="{StaticResource SectionLabelStyle}" />
                                      <TextBox Grid.Row="10"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="3"
                                               x:Name="GameChatWebhookTextBox"
                                               TextChanged="OperationsEditorChanged"
                                               ToolTip="Optional Discord webhook for in-game chat relayed by the Game Bridge mod. Leave blank to only store chat locally." />

                                     <TextBlock Grid.Row="11" Grid.Column="0" Text="Discord role ID" Style="{StaticResource SectionLabelStyle}" />
                                      <TextBox Grid.Row="11"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="3"
                                               x:Name="MaintenanceRoleIdTextBox"
                                              TextChanged="OperationsEditorChanged"
                                              ToolTip="Optional Discord role ID to ping for restart, update, and maintenance notices. Leave blank for no role mention." />

                                     <Button Grid.Row="12"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="4"
                                             Content="Save Operations"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Click="SaveOperationsButton_Click" />
                                </Grid>
                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Server Update">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">
                                            <GroupBox Header="Shared Dedicated Server Update">
                                                <StackPanel>
                                                     <TextBlock Text="Check SteamCMD for the latest dedicated server build, then apply it through the shared maintenance plan. If any configured tiles / host profiles are running, the manager queues one restart for the whole running pool, stops them, runs SteamCMD, then starts them again."
                                                                Foreground="{StaticResource SubtleTextBrush}"
                                                                TextWrapping="Wrap"
                                                                Margin="0,0,0,12" />
                                                     <TextBlock Text="Automatic dedicated server updates can be enabled in Setup / Webhooks. They use the same shared plan and the Server update minutes interval."
                                                                Foreground="{StaticResource SubtleTextBrush}"
                                                                TextWrapping="Wrap"
                                                                Margin="0,0,0,12" />
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button x:Name="CheckServerUpdateButton"
                                                                Content="Check Server Update"
                                                                Click="CheckServerUpdateButton_Click"
                                                                ToolTip="Compare the local dedicated server build ID with SteamCMD app info. This does not stop or update servers." />
                                                        <Button x:Name="ApplyServerUpdateButton"
                                                                Content="Apply Shared Server Update"
                                                                Click="ApplyServerUpdateButton_Click"
                                                                ToolTip="If configured tiles / host profiles are running, queue one shared maintenance restart and run SteamCMD after they stop. If hosts are offline, update immediately." />
                                                    </WrapPanel>
                                                    <Border Background="{StaticResource PanelBrushAlt}"
                                                            BorderBrush="{StaticResource BorderBrushWarm}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12">
                                                        <TextBlock x:Name="ServerUpdateSummaryTextBlock"
                                                                   Text="No server update check has run in this session."
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Workshop Actions">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">
                            <GroupBox Header="Shared Workshop Actions">
                                <StackPanel>
                                    <TextBlock Text="Use these buttons for the shared workshop flow: add one mod by URL or ID, sync the configured mod list, apply pending updates, or build one combined restart plan for all running configured tiles / host profiles."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="InstallWorkshopModButton"
                                                Content="Install Mod From URL / ID"
                                                Click="InstallWorkshopModButton_Click"
                                                ToolTip="Paste a Steam Workshop URL or a numeric workshop item ID. The manager adds it to the configured list and syncs it immediately." />
                                        <Button x:Name="SyncModsButton"
                                                Content="Sync Shared Mod Set"
                                                Click="SyncModsButton_Click"
                                                ToolTip="Download and mirror every configured workshop mod into the server mods folder right now." />
                                        <Button x:Name="ReconcileModsButton"
                                                Content="Sync + Shared Restart Plan"
                                                Click="ReconcileModsButton_Click"
                                                ToolTip="Refresh the configured workshop mods, then tell you in one result whether anything changed and whether one shared restart was queued." />
                                        <Button x:Name="CheckModUpdatesButton"
                                                Content="Apply Shared Mod Updates"
                                                Click="CheckModUpdatesButton_Click"
                                                ToolTip="Refresh workshop metadata, apply pending configured mod updates, and queue one shared 15-minute restart if needed." />
                                    </WrapPanel>
                                    <Border Background="{StaticResource PanelBrushAlt}"
                                            BorderBrush="{StaticResource BorderBrushWarm}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="12">
                                        <TextBlock x:Name="ModActionSummaryTextBlock"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource SubtleTextBrush}" />
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Install Paths">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">
                            <GroupBox Header="Install Paths and Storage">
                                <StackPanel>
                                    <TextBlock Text="Keep setup as simple as the working launcher: choose only the dedicated server path, SteamCMD folder, and reusable profile folder. The tool installs SteamCMD and the server automatically, derives the rest, and you can change the rest later in the manager."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="Save Install Paths" Click="SaveInstallContextButton_Click" ToolTip="Save the core machine paths and reload the control center backend with the updated install context." />
                                        <Button Content="Re-run Setup Wizard" Click="RunSetupWizardButton_Click" ToolTip="Open the same setup wizard used during install so the owner can choose paths again." />
