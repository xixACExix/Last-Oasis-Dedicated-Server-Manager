                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Game Bridge">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="Local bridge for restart warnings, update notices, admin messages, and future in-game chat capture. All servers writes one command per live tile identifier; one tile writes only that tile file."
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />

                            <GroupBox Header="LOManagerBridge Paths">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Text="Inbox root"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="0"
                                             Grid.Column="1"
                                             x:Name="GameBridgeInboxRootPathTextBox"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Root folder watched by LOManagerBridge. Defaults derive the fallback files plus Tiles, TilesNW, and TilesDC below this folder." />
                                    <Button Grid.Row="0"
                                            Grid.Column="2"
                                            Content="Choose Inbox Root"
                                            Click="BrowseGameBridgeInboxRootButton_Click"
                                            ToolTip="Choose the LOManagerBridge Inbox folder. The manager will create missing files and subfolders automatically." />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Fallback Admin.json"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             x:Name="GameBridgeCommandFilePathTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Fallback global widget file used only when the manager cannot find live tile identifiers, or for manual bridge testing." />
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Content="Choose Admin.json"
                                            Margin="0,8,0,0"
                                            Click="BrowseGameBridgeCommandPathButton_Click"
                                            ToolTip="Choose or create the fallback Admin.json file." />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Fallback no-widget"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="GameBridgeNoWidgetCommandFilePathTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Fallback global no-widget file used only when the manager cannot find live tile identifiers." />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               Text="Tile widget folder"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="3"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="GameBridgeTileWidgetDirectoryTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Folder for live tile messages with widget support, normally Inbox\Tiles. All-server widget sends fan out here." />
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               Text="Tile no-widget folder"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="4"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="GameBridgeTileNoWidgetDirectoryTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Folder for live tile messages without widget support, normally Inbox\TilesNW. All-server no-widget sends fan out here." />
                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               Text="Discord tile folder"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="5"
                                             Grid.Column="1"
                                             Grid.ColumnSpan="2"
                                             x:Name="GameBridgeTileDiscordDirectoryTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Folder used for Discord-to-game tile messages, normally Inbox\TilesDC." />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Discord Reply Bot">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Row="0"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              x:Name="DiscordReplyBotEnabledCheckBox"
                                              Content="Send Discord replies back to the matching live tile"
                                              Checked="OperationsEditorChanged"
                                              Unchecked="OperationsEditorChanged"
                                              ToolTip="The backend bot listens only in the configured chat channel, ignores bots, and only accepts replies to Manager chat embeds." />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Text="Bot token"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <PasswordBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 x:Name="DiscordReplyBotTokenTextBox"
                                                 Margin="0,8,0,0"
                                                 PasswordChanged="OperationsEditorChanged"
                                                 ToolTip="Discord bot token. The bot needs Guild Messages and Message Content intents." />
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               Text="Chat channel ID"
                                               VerticalAlignment="Center"
                                               Margin="0,8,0,0"
                                               Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             x:Name="DiscordReplyBotChannelIdTextBox"
                                             Margin="0,8,0,0"
                                             TextChanged="OperationsEditorChanged"
                                             ToolTip="Discord channel ID where the Last Oasis Chat embeds are posted. Replies in other channels are ignored." />
                                </Grid>
                            </GroupBox>

                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox x:Name="GameBridgeModMessagesCheckBox"
                                          Content="Write LOManagerBridge command files"
                                          Checked="OperationsEditorChanged"
                                          Unchecked="OperationsEditorChanged"
                                          Margin="0,0,18,8"
                                          ToolTip="When enabled, all-server sends write one file per live tile. Fallback Admin.json/AdminNOwidget files are used only when no live tile identifier is available." />
                                <Button Content="Save Bridge Setting" Click="SaveOperationsButton_Click" />
                                <Button Content="Refresh Bridge" Click="RefreshGameBridgeButton_Click" />
                                <Button Content="Clear Queue" Click="ClearGameBridgeMessagesButton_Click" ToolTip="Clears queued manager-side message history. It does not change LOManagerBridge command files." />
                            </WrapPanel>

                            <GroupBox Header="Bridge Status">
                                <TextBox x:Name="GameBridgeStatusTextBox"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         Height="145"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" />
                            </GroupBox>

                            <GroupBox Header="Send Admin Message">
                                <StackPanel>
                                    <TextBox x:Name="AdminGameMessageTextBox"
                                             AcceptsReturn="True"
                                             Height="80"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="All servers writes an AdminMessage command to each live tile file. One tile writes only that tile file." />
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="Target" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Margin="0,0,8,0" />
                                        <ComboBox x:Name="GameBridgeTargetComboBox"
                                                  Width="260"
                                                  DisplayMemberPath="Label"
                                                  ToolTip="All servers fans out to every live tile identifier. One live tile writes only that identifier's file." />
                                        <CheckBox x:Name="GameBridgeWithWidgetCheckBox"
                                                  Content="Use widget path"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,16,0"
                                                  ToolTip="Enabled uses the Tiles folder. Disabled uses the TilesNW folder. Restart warnings use widget-capable tile files so the countdown can appear." />
                                        <TextBlock Text="Seconds" VerticalAlignment="Center" Style="{StaticResource SectionLabelStyle}" Margin="0,0,8,0" />
                                        <TextBox x:Name="AdminGameMessageDurationTextBox" Width="70" Text="12" />
                                        <Button Content="Queue Admin Message" Click="SendGameBridgeAdminMessageButton_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Bridge Message History">
                                <DataGrid x:Name="GameBridgeMessagesGrid" Height="250" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="155" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="125" />
                                        <DataGridTextColumn Header="Target" Binding="{Binding TargetLabel}" Width="180" />
                                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                                        <DataGridTextColumn Header="Delivered / command written" Binding="{Binding DeliveredAt}" Width="155" />
                                        <DataGridTextColumn Header="Ack / consumed" Binding="{Binding AcknowledgedAt}" Width="155" />
                                        <DataGridTextColumn Header="Command path" Binding="{Binding CommandFilePath}" Width="240" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Header="Captured Game Chat">
                                <DataGrid x:Name="GameBridgeChatGrid" Height="250" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt}" Width="155" />
                                        <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="90" />
                                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="150" />
                                        <DataGridTextColumn Header="Map" Binding="{Binding MapName}" Width="150" />
                                        <DataGridTextColumn Header="Tile" Binding="{Binding TileName}" Width="160" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Diagnostics / Safety">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox x:Name="SafeModeCheckBox"
                                          Content="Safe mode: disable destructive day-to-day actions"
                                          Checked="SafeModeCheckBox_Changed"
                                          Unchecked="SafeModeCheckBox_Changed"
                                          Margin="0,0,18,8" />
                                <Button Content="Refresh Audit" Click="RefreshAuditButton_Click" />
                                <Button Content="Check Message Bridge" Click="CheckMessageBridgeButton_Click" />
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,10">
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="330">
                                        <TextBlock Text="Restart and update lock" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="RestartLockStatusText" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="360">
                                        <TextBlock Text="Warning destinations" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="WarningDestinationsText" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="360">
                                        <TextBlock Text="In-game message bridge" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="MessageBridgeStatusText" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <GroupBox Header="Remote Web Password">
                                <StackPanel>
                                    <TextBlock Text="Change the password used by the phone/web remote panel. It is saved as remote-access.json in the active LO_Profiles folder and existing remote sessions are cleared."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="New password" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <PasswordBox x:Name="RemotePasswordBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Confirm password" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <PasswordBox x:Name="RemotePasswordConfirmBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                                        <Button Grid.Row="2"
                                                Grid.Column="1"
                                                Content="Save Remote Password"
                                                HorizontalAlignment="Left"
                                                Click="SaveRemotePasswordButton_Click"
                                                ToolTip="Save the remote web password to the active LO_Profiles remote-access.json file." />
                                        <TextBlock x:Name="RemotePasswordStatusText"
                                                   Grid.Row="2"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Steam Login Secret">
                                <StackPanel>
                                    <TextBlock Text="Optional server Steam account for the managed MyRealm browser login and Steam desktop client login. The password is saved in steam-login.json and encrypted by Windows for this Windows user."
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Steam login name" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox x:Name="SteamLoginAccountTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Steam password" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <PasswordBox x:Name="SteamLoginPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
                                        <CheckBox x:Name="SteamClientAutoLoginCheckBox"
                                                  Grid.Row="2"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  Content="Auto-login the Steam desktop client when the backend starts"
                                                  IsChecked="True"
                                                  Margin="0,0,0,8"
                                                  ToolTip="Uses the saved encrypted Steam secret to start Steam.exe with the server account at backend startup." />
                                        <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                                            <Button Content="Save Steam Login"
                                                    Click="SaveSteamLoginButton_Click"
                                                    ToolTip="Save the Steam login name and encrypted password into the active LO_Profiles folder." />
                                            <Button Content="Load Saved Status"
                                                    Click="RefreshSteamLoginButton_Click"
                                                    ToolTip="Check whether a Steam login secret is already saved." />
                                            <Button Content="Login Steam Client Now"
                                                    Click="LoginSteamClientButton_Click"
                                                    ToolTip="Start Steam.exe with the saved server Steam account. Steam may still ask for manual verification if Steam blocks the login." />
                                            <Button Content="Check Steam Client"
                                                    Click="RefreshSteamClientButton_Click"
                                                    ToolTip="Check whether Steam.exe is found and whether the Steam client process is running." />
                                            <Button Content="Clear Steam Login"
                                                    Click="ClearSteamLoginButton_Click"
                                                    ToolTip="Delete the saved Steam login secret from the active LO_Profiles folder." />
                                        </WrapPanel>
                                        <TextBlock x:Name="SteamLoginStatusText"
                                                   Grid.Row="4"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="Steam login secret has not been checked yet."
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="SteamClientStatusText"
                                                   Grid.Row="5"
                                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Text="Steam client status has not been checked yet."
                                                   Foreground="{StaticResource SubtleTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="First-run Health Checklist">
                                <DataGrid x:Name="HealthChecksGrid" Height="210" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State" Binding="{Binding StateLabel}" Width="70" />
                                        <DataGridTextColumn Header="Check" Binding="{Binding Label}" Width="210" />
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="260" />
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Header="MyRealm API Probe">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="Run Safe API Probe" Click="RunApiProbeButton_Click" ToolTip="Checks only known docs/API routes with safe GET requests and status codes." />
                                        <TextBlock x:Name="ApiProbeSummaryText" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                                    </WrapPanel>
                                    <DataGrid x:Name="ApiProbeGrid" Height="230" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Check" Binding="{Binding Label}" Width="170" />
                                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="170" />
                                            <DataGridTextColumn Header="Header" Binding="{Binding HeaderMode}" Width="95" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                                            <DataGridTextColumn Header="Type" Binding="{Binding ContentType}" Width="180" />
                                            <DataGridTextColumn Header="Redirect" Binding="{Binding RedirectedTo}" Width="220" />
                                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Manager Audit Log">
                                <DataGrid x:Name="ManagerAuditGrid" Height="260" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt}" Width="155" />
                                        <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="120" />
                                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <GroupBox Header="Redacted Diagnostic Bundle">
                                <StackPanel>
                                    <Button Content="Export Redacted Diagnostics" Width="210" HorizontalAlignment="Left" Click="ExportDiagnosticsButton_Click" />
                                    <TextBox x:Name="DiagnosticBundleTextBox"
                                             Height="260"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1,1,1,0" Padding="12">
            <TextBlock x:Name="ActionStatusTextBlock" Text="Native desktop client ready." Foreground="{StaticResource AccentBrush}" />
        </Border>
    </Grid>
</Window>
