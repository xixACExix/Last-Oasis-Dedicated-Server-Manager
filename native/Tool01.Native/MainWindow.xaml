                                        <TextBlock x:Name="MyRealmRealmText" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                    <StackPanel Width="180">
                                        <TextBlock Text="Tiles" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="MyRealmTilesText" FontSize="22" FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrushAlt}" CornerRadius="12" Padding="14" Margin="0,0,10,10">
