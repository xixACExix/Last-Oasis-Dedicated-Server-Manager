                                        <ComboBoxItem Content="fixed" />
                                        <ComboBoxItem Content="random" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Fixed quality" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="3" Grid.Column="3" x:Name="FixedQualityTextBox" TextChanged="EventEditorChanged" ToolTip="Fixed event tile quality from 1 to 4." />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Random quality min" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="QualityMinTextBox" TextChanged="EventEditorChanged" ToolTip="Minimum random tile quality." />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="Random quality max" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="4" Grid.Column="3" x:Name="QualityMaxTextBox" TextChanged="EventEditorChanged" ToolTip="Maximum random tile quality." />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Choose your mode" Style="{StaticResource SectionLabelStyle}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="PvpModeComboBox" SelectionChanged="EventEditorChanged" ToolTip="Choose whether generated event tiles are PvE or full PvP.">
                                        <ComboBoxItem Content="PvE" Tag="NoPvp" />
                                        <ComboBoxItem Content="PvP" Tag="FullPvp" />
                                    </ComboBox>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Background rollover" Style="{StaticResource SectionLabelStyle}" />
                                    <CheckBox Grid.Row="5" Grid.Column="3" x:Name="EventAutoAdvanceCheckBox" Content="Automatic" Checked="EventEditorChanged" Unchecked="EventEditorChanged" />
                                </Grid>
                                </StackPanel>
                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
