                                    <StackPanel Width="420">
                                        <TextBlock Text="Active batch" Style="{StaticResource SectionLabelStyle}" />
                                        <TextBlock x:Name="EventActiveBatchText" TextWrapping="Wrap" FontSize="16" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Settings">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">

                            <GroupBox x:Name="EventEditorGroupBox" Header="Selected Cycle Settings">
                                <StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <TextBlock Text="Cycle name"
