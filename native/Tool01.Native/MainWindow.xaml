                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <TabControl Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushWarm}" BorderThickness="1">
                                <TabItem Header="Cycle">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12">
                            <GroupBox Header="Cycle Library">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,10">
                                        <TextBlock Text="Choose your cycle"
                                                   Style="{StaticResource SectionLabelStyle}"
                                                   Width="120"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0" />
