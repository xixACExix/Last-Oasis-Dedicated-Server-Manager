                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Column="0" Text="Tiles per cycle" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="1" x:Name="CycleSizeTextBox" TextChanged="EventEditorChanged" ToolTip="How many event tiles to create in each cycle." />
                                    <TextBlock Grid.Column="2" Text="Preview hours" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Column="3" x:Name="PreviewHoursTextBox" TextChanged="EventEditorChanged" ToolTip="How long tiles stay visible before activation." />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Active hours" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ActiveHoursTextBox" TextChanged="EventEditorChanged" ToolTip="How long event tiles stay active before deactivation." />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Delete after deactivation" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="DeleteGraceHoursTextBox" TextChanged="EventEditorChanged" ToolTip="How many hours to keep a dead event tile before deleting it." />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Event name prefix" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="NamePrefixTextBox" TextChanged="EventEditorChanged" ToolTip="Prefix added to every generated event tile name." />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Max spacing from anchor" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="SpacingRadiusTextBox" TextChanged="EventEditorChanged" ToolTip="Maximum distance from the chosen anchor tiles when placing new event tiles." />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Choose your mode" Style="{StaticResource SectionLabelStyle}" />
