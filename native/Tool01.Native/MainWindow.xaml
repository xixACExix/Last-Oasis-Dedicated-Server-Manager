                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Map" Binding="{Binding MapName}" Width="*" />
                                        <DataGridTextColumn Header="Difficulty" Binding="{Binding Difficulty}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
