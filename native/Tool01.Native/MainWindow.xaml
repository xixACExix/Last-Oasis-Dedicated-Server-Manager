                                        <DataGridTextColumn Header="Tile" Binding="{Binding TileName}" Width="220" />
                                        <DataGridTextColumn Header="Map" Binding="{Binding MapName}" Width="170" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110" />
                                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60" />
                                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60" />
