<Window x:Class="Tool01.Native.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Event Cycle"
        Width="520"
        MinWidth="520"
        MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#180E09"
        Foreground="#F3E5D3">
    <Window.Resources>
        <SolidColorBrush x:Key="PromptPanelBrush" Color="#24140D" />
        <SolidColorBrush x:Key="PromptAccentBrush" Color="#D8A45D" />
        <SolidColorBrush x:Key="PromptAccentMutedBrush" Color="#7A5225" />
        <SolidColorBrush x:Key="PromptTextBrush" Color="#F3E5D3" />
        <SolidColorBrush x:Key="PromptSubtleTextBrush" Color="#C7AC8A" />
        <SolidColorBrush x:Key="PromptBorderBrush" Color="#5B3B21" />

        <Style x:Key="PromptButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PromptAccentBrush}" />
            <Setter Property="Foreground" Value="#2A180E" />
            <Setter Property="BorderBrush" Value="{StaticResource PromptAccentMutedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PromptSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PromptButtonStyle}">
            <Setter Property="Background" Value="#2B190F" />
            <Setter Property="Foreground" Value="{StaticResource PromptTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PromptBorderBrush}" />
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Padding="18"
            Background="{StaticResource PromptPanelBrush}"
            BorderBrush="{StaticResource PromptBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptTitleTextBlock"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource PromptTextBrush}"
                       Text="Create Event Cycle" />

            <TextBlock x:Name="PromptMessageTextBlock"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource PromptAccentBrush}"
                       TextWrapping="Wrap"
                       Text="Choose a name for the new event cycle." />

            <TextBlock x:Name="PromptLabelTextBlock"
                       Grid.Row="2"
                       Margin="0,16,0,8"
                       Foreground="{StaticResource PromptTextBrush}"
                       FontWeight="SemiBold"
                       Text="Cycle name" />

            <TextBox x:Name="PromptTextBox"
                     Grid.Row="3"
                     Height="42"
                     VerticalContentAlignment="Center"
                     Background="#FFF7EA"
                     Foreground="#1B110B"
                     BorderBrush="{StaticResource PromptAccentBrush}"
                     BorderThickness="2"
                     FontSize="16"
                     Padding="12,6" />

            <TextBlock Grid.Row="4"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource PromptSubtleTextBrush}"
                       TextWrapping="Wrap"
                       Text="Press Enter to confirm or Escape to cancel." />

            <Grid Grid.Row="5" Margin="0,22,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Width="110"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Style="{StaticResource PromptSecondaryButtonStyle}"
                        Click="CancelButton_Click" />
                <Button x:Name="ConfirmButton"
                        Grid.Column="2"
                        Content="Create"
                        Width="120"
                        IsDefault="True"
                        Style="{StaticResource PromptButtonStyle}"
                        Click="ConfirmButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
